цел счётчик

алг Главная
нач
  вещ a, b
  лит op
  вывод "Введите два числа и знак операции (+ - * /): ", нс
  ввод a, b, op
  выбор
    при op = "+": вывод сложение(a, b), нс
    при op = "-": вывод вычитание(a, b), нс
    при op = "*": вывод умножение(a, b), нс
    при op = "/":
      если b = 0
        то вывод "Ошибка: деление на ноль", нс
        иначе вывод деление(a, b), нс
      все
    иначе вывод "Неизвестная операция", нс
  все

  цел p, q
  p := 5
  q := 10
  вывод "До обмена: ", p, " ", q, нс
  обмен_по_значению(p, q)
  вывод "После обмена по значению: ", p, " ", q, нс
  обмен_по_ссылке(p, q)
  вывод "После обмена по ссылке: ", p, " ", q, нс

  счётчик := 0
  вызов_счётчика
  вызов_счётчика
  вызов_счётчика
кон

алг вещ сложение(арг вещ x, y)
нач
  знач := x + y
кон

алг вещ вычитание(арг вещ x, y)
нач
  знач := x - y
кон

алг вещ умножение(арг вещ x, y)
нач
  знач := x * y
кон

алг вещ деление(арг вещ x, y)
нач
  знач := x / y
кон

алг обмен_по_значению(арг цел x, y)
нач
  цел u, v, t
  u := x
  v := y
  t := u
  u := v
  v := t
  вывод "Внутри процедуры (копии): ", u, " ", v, нс
кон

алг обмен_по_ссылке(аргрез цел x, y)
нач
  цел t
  t := x
  x := y
  y := t
кон

алг вызов_счётчика
нач
  счётчик := счётчик + 1
  вывод "Процедура вызвана раз: ", счётчик, нс
кон