<Window x:Class="ElectronicsStoreApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интернет магазин"
        Icon="pack://application:,,,/Resources/free-icon-font-shopping-bag-3916664.png"
        Height="790" Width="900"
        MinHeight="680" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Синий заголовок -->
        <Border Grid.Row="0"
                Background="#142B4A"
                CornerRadius="16"
                Padding="24,20"
                Margin="0,0,0,18">

            <Grid>
                <TextBlock Text="Интернет магазин"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
            </Grid>
        </Border>

        <!-- Карточки заданий -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Задание 1 -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="18"
                        Margin="0,0,10,14">

                    <StackPanel>
                        <TextBlock Text="ЗАДАНИЕ 1"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold" />

                        <TextBlock Text="Работа с товарами"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,2" />

                        <Button Content="📋  Показать товары"
                                Style="{StaticResource MenuActionButton}"
                                Click="ShowProducts_Click" />

                        <Button Content="➕  Добавить товар"
                                Style="{StaticResource MenuActionButton}"
                                Click="AddProduct_Click" />

                        <Button Content="📦  Проверить остаток товара"
                                Style="{StaticResource MenuActionButton}"
                                Click="CheckStock_Click" />
                    </StackPanel>
                </Border>

                <!-- Задание 2 -->
                <Border Grid.Row="0" Grid.Column="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="18"
                        Margin="10,0,0,14">

                    <StackPanel>
                        <TextBlock Text="ЗАДАНИЕ 2"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold" />

                        <TextBlock Text="Отсоединённый режим"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,2" />

                        <Button Content="🗂️  Работа с DataTable"
                                Style="{StaticResource MenuActionButton}"
                                Click="DataTable_Click" />
                    </StackPanel>
                </Border>

                <!-- Задание 3 -->
                <Border Grid.Row="1" Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="18"
                        Margin="0,0,10,14">

                    <StackPanel>
                        <TextBlock Text="ЗАДАНИЕ 3"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold" />

                        <TextBlock Text="LINQ to SQL"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,2" />

                        <Button Content="🏆  Топ-3 продаваемых товара"
                                Style="{StaticResource MenuActionButton}"
                                Click="TopProducts_Click" />
                    </StackPanel>
                </Border>

                <!-- Задание 4 -->
                <Border Grid.Row="1" Grid.Column="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="18"
                        Margin="10,0,0,14">

                    <StackPanel>
                        <TextBlock Text="ЗАДАНИЕ 4"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold" />

                        <TextBlock Text="Entity Framework"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,2" />

                        <Button Content="🛒  Оформить заказ"
                                Style="{StaticResource MenuActionButton}"
                                Click="PlaceOrder_Click" />
                    </StackPanel>
                </Border>

                <!-- Задание 5 -->
                <Border Grid.Row="2" Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="18"
                        Margin="0,0,10,14">

                    <StackPanel>
                        <TextBlock Text="ЗАДАНИЕ 5"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Bold" />

                        <TextBlock Text="Dapper"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,2" />

                        <Button Content="😴  Показать неактивных клиентов"
                                Style="{StaticResource MenuActionButton}"
                                Click="SleepingCustomers_Click" />
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- Нижняя строка состояния -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,4,0,0">

            <TextBlock x:Name="StatusTextBlock"
                       Text="Текущее окно: Главное меню"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>

    </Grid>
    
</Window>
    
